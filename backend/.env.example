# Copy to `.env` and adjust. Never commit a real `.env`.
# The full prerequisite list lives in REQUIREMENTS.txt.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL. Host/port match docker-compose.yml as seen from the host machine.
# Inside the compose network the host is `postgres`, not `localhost`.
DATABASE_URL=postgresql://carnival:carnival_dev_password@localhost:5432/carnival?schema=public

# Redis. Inside the compose network the host is `redis`.
REDIS_URL=redis://localhost:6379

# Comma-separated origins, or * to allow all (development only).
CORS_ORIGIN=http://localhost:5173

# Access-token signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_generate_at_least_32_random_characters_here

LOG_LEVEL=log
